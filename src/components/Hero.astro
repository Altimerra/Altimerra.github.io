---
---

<section id="home" class="hero">
	<div class="container hero-container fade-in-up">
		<div class="hero-content">
			<span class="greeting">Hello, I'm</span>
			<h1 class="name">Harindu <span class="text-gradient">Bandara</span></h1>
			
			<div class="typing-container">
				<p class="role typing-text"></p>
				<span class="cursor">|</span>
			</div>
			
			<p class="description">
				M.Sc. student at TUM specializing in Mechatronics, Bionics and Robotics.
				Experienced in R&D, engineering design, and academic instruction.
			</p>
			
			<div class="cta-group">
				<a href="#projects" class="btn btn-primary">View Work</a>
				<a href="#contact" class="btn btn-secondary">Contact Me</a>
			</div>
		</div>
		
		<div class="hero-visual">
			<div class="glow-circle"></div>
			<!-- Augmented Reality / Engineering Vibe -->
			<div class="visual-card glass-card floating">
				<div class="card-header">
					<span class="status-dot"></span>
					<span class="status-text">System Online</span>
				</div>
				<div class="code-block">
					<pre><code><span class="keyword">class</span> <span class="class-name">RoboticsEngineer</span> &#123;
  <span class="keyword">public</span>:
    <span class="type">string</span> name = <span class="string">"Harindu"</span>;
    <span class="type">string</span> focus = <span class="string">"Bionics"</span>;
    
    <span class="keyword">void</span> <span class="function">innovate</span>() &#123;
      <span class="comment">// TODO: Build future</span>
    &#125;
&#125;;</code></pre>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const text = "Robotics & Mechatronics Engineer";
	const typingText = document.querySelector('.typing-text');
	let i = 0;

	function typeWriter() {
		if (i < text.length && typingText) {
			typingText.innerHTML += text.charAt(i);
			i++;
			setTimeout(typeWriter, 50 + Math.random() * 50);
		}
	}

	// Start typing after a short delay
	setTimeout(typeWriter, 500);
</script>

<style>
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding-top: 60px; /* Offset for fixed header */
	}

	.hero-container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.greeting {
		font-size: 1.25rem;
		color: var(--color-accent);
		font-weight: 500;
	}

	.name {
		font-size: 4rem;
		line-height: 1.1;
		letter-spacing: -1px;
	}

	/* Typing Effect Styles */
	.typing-container {
		display: flex;
		align-items: center;
		height: 2rem; /* Reserve height */
	}

	.role {
		font-size: 1.5rem;
		color: var(--color-text-muted);
		font-weight: 500;
		margin: 0;
	}

	.cursor {
		font-size: 1.5rem;
		color: var(--color-primary);
		animation: blink 1s step-end infinite;
		margin-left: 5px;
	}

	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}

	.description {
		font-size: 1.125rem;
		color: var(--color-text-muted);
		max-width: 500px;
		line-height: 1.6;
	}

	.cta-group {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
	}

	.btn {
		padding: 0.75rem 1.5rem;
		border-radius: 0.5rem;
		font-weight: 600;
		transition: all 0.2s;
	}

	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 20px rgba(59, 130, 246, 0.4);
	}

	.btn-primary {
		background: var(--gradient-main);
		color: white;
	}

	.btn-secondary {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: var(--color-text);
	}

	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	.hero-visual {
		position: relative;
		display: flex;
		justify-content: center;
		perspective: 1000px;
	}

	/* Simulated Code Mockup */
	.visual-card {
		padding: 2rem;
		width: 100%;
		max-width: 450px;
		position: relative;
		z-index: 1;
		background: rgba(15, 23, 42, 0.8); /* Darker blue bg */
		border: 1px solid rgba(59, 130, 246, 0.3);
	}

	.floating {
		animation: float 6s ease-in-out infinite;
	}

	@keyframes float {
		0% { transform: translateY(0px) rotateY(-5deg) rotateX(5deg); }
		50% { transform: translateY(-20px) rotateY(-5deg) rotateX(5deg); }
		100% { transform: translateY(0px) rotateY(-5deg) rotateX(5deg); }
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.status-dot {
		width: 8px;
		height: 8px;
		background: #22c55e;
		border-radius: 50%;
		box-shadow: 0 0 10px #22c55e;
	}

	.status-text {
		font-size: 0.8rem;
		color: #22c55e;
		font-family: monospace;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	pre {
		font-family: 'JetBrains Mono', 'Menlo', monospace;
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.keyword { color: #c084fc; }
	.class-name { color: #facc15; }
	.type { color: #60a5fa; }
	.string { color: #a3e635; }
	.comment { color: #6b7280; font-style: italic; }
	.function { color: #f472b6; }

	.glow-circle {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 300px;
		height: 300px;
		background: var(--color-primary);
		filter: blur(120px);
		opacity: 0.2;
		z-index: 0;
	}

	@media (max-width: 968px) {
		.hero-container {
			grid-template-columns: 1fr;
			text-align: center;
			gap: 3rem;
		}

		.hero-content {
			align-items: center;
		}

		.name {
			font-size: 3rem;
		}

		.description {
			margin: 0 auto;
		}
		
		.typing-container {
			justify-content: center;
		}
	}
</style>
