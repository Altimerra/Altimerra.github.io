---
const education = [
	{
		school: "Technical University of Munich",
		degree: "M.Sc. Mechatronics, Robotics and Biomechanical Engineering",
		year: "2025 - Present",
		details: "Member of Enhands, Candidate at TUM Venture Labs"
	},
	{
		school: "University of Moratuwa",
		degree: "B.Sc. Mechanical Engineering",
		year: "2020 - 2024",
		details: "GPA: 3.52 (German equivalent: 1.7), Dean's List. Research: Trans-radial prosthetic device."
	}
];

const skills = [
	{ name: "Programming", items: ["C++", "Python", "Julia", "MATLAB", "JavaScript"] },
	{ name: "Engineering", items: ["ROS", "Control Systems", "Biomedical Eng", "Mechanics"] },
	{ name: "Design & Tools", items: ["SolidWorks", "COMSOL", "Rapid Research", "Technical Writing"] },
];
---

<section id="about" class="about fade-in-up">
	<div class="container">
		<h2 class="section-title">About <span class="text-gradient">Me</span></h2>
		
		<div class="about-grid">
			<div class="about-content">
				<p>
					I am a Robotics & Mechatronics Engineer currently pursuing my Master's at the Technical University of Munich.
					I specialize in Bionics and Robotics, with a strong foundation in Mechanical Engineering from the University of Moratuwa.
				</p>
				<p>
					My passion lies in Research & Development, where I apply my skills in engineering design, control systems, and AI
					to solve complex problems in the medical and industrial sectors.
				</p>

				<h3 class="sub-title">Education</h3>
				<div class="education-list">
					{education.map((edu) => (
						<div class="edu-item">
							<div class="edu-header">
								<h4>{edu.school}</h4>
								<span class="year">{edu.year}</span>
							</div>
							<p class="degree">{edu.degree}</p>
							<p class="details">{edu.details}</p>
						</div>
					))}
				</div>
			</div>

			<div class="skills-container">
				<h3 class="sub-title">Skills</h3>
				{skills.map((category) => (
					<div class="skill-card glass-card">
						<h4>{category.name}</h4>
						<div class="tags">
							{category.items.map((item) => (
								<span class="tag">{item}</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		padding: 6rem 0;
	}

	.section-title {
		font-size: 2.5rem;
		margin-bottom: 3rem;
		text-align: center;
	}

	.sub-title {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
		color: var(--color-text);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 4rem;
		align-items: start;
	}

	.about-content p {
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--color-text-muted);
		margin-bottom: 1.5rem;
		font-weight: 300;
	}

	.education-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin-top: 2rem;
	}

	.edu-item {
		border-left: 2px solid var(--color-primary);
		padding-left: 1.5rem;
	}

	.edu-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 0.5rem;
	}

	.edu-header h4 {
		font-size: 1.2rem;
		color: var(--color-text);
	}

	.year {
		font-size: 0.9rem;
		color: var(--color-accent);
		font-weight: 500;
	}

	.degree {
		font-size: 1rem;
		color: var(--color-text-muted);
		margin-bottom: 0.5rem !important;
		font-weight: 500;
	}

	.details {
		font-size: 0.9rem !important;
		margin-bottom: 0 !important;
	}

	.skills-container {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.skill-card {
		padding: 1.5rem;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		position: relative;
		overflow: hidden;
	}

	.skill-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: var(--gradient-glow);
		opacity: 0;
		transition: opacity 0.4s ease;
		z-index: -1;
	}

	.skill-card:hover {
		transform: translateY(-5px);
		border-color: rgba(6, 182, 212, 0.5); /* Cyan border */
		box-shadow: 
			0 10px 40px -10px rgba(6, 182, 212, 0.3),
			var(--glass-shadow);
	}

	.skill-card:hover::before {
		opacity: 0.2;
	}

	.skill-card h4 {
		font-size: 1.1rem;
		margin-bottom: 1rem;
		color: var(--color-primary);
		text-shadow: 0 0 20px rgba(6, 182, 212, 0.3);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.tag {
		font-size: 0.9rem;
		padding: 0.4rem 0.8rem;
		background: rgba(255, 255, 255, 0.05);
		border-radius: 2rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: var(--color-text-muted);
	}

	@media (max-width: 768px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
		
		.edu-header {
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>
